# Environment Variables Configuration

# ============================================
# AUTHENTICATION (REQUIRED FOR AUTH SYSTEM)
# ============================================
# Generate random secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-minimum-32-chars-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-minimum-32-chars-change-in-production

# ============================================
# TEST/ADMIN USER CREDENTIALS (OPTIONAL - DEVELOPMENT ONLY)
# ============================================
# These credentials can be used to create a test/admin user for development
# WARNING: Never commit real production credentials to version control
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=YourPassword123

# ============================================
# DATABASE CONFIGURATION (existing)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ============================================
# GOOGLE SHEETS CONFIGURATION (NEW - REQUIRED)
# ============================================

# Your Google Sheet ID for store registrations
# Find this in the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# Example: GOOGLE_SHEETS_STORE_REGISTRATION_ID=1abc123def456ghi789jkl
GOOGLE_SHEETS_STORE_REGISTRATION_ID=

# ============================================
# OFFLINE STORE SYNC SCHEDULER (OPTIONAL)
# ============================================

# Shared secret used by Google Apps Script webhook calls.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORE_SYNC_WEBHOOK_SECRET=b15aa72378779bca0f877918ab2e2b12b8cf4d2fad438e983d4fb2a5914462f2

# Cron schedule for automatic sync (default: every 10 minutes)
# Format: minute hour day month day-of-week
# Examples:
#   */10 * * * *  = Every 10 minutes (default)
#   */5 * * * *   = Every 5 minutes
#   0 * * * *     = Every hour
#   0 0 * * *     = Every day at midnight
#   0 */2 * * *   = Every 2 hours
# OFFLINE_STORE_SYNC_SCHEDULE=*/10 * * * *

# ============================================
# IMPORTANT: Google Sheets Permissions
# ============================================
# Make sure to share your Google Sheet with this service account email:
# dropiq@gen-lang-client-0169377687.iam.gserviceaccount.com
# 
# Steps:
# 1. Open your Google Sheet
# 2. Click "Share" button (top right)
# 3. Enter the email above
# 4. Set permission to "Viewer" or "Editor"
# 5. Click "Send"
