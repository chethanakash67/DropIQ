{
  "name": "dropiq-product-search",
  "version": "1.0.0",
  "description": "Product search platform with Apify integration",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "dev:landing": "cd Landing_page && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:landing\" \"npm run dev:client\"",
    "scheduler": "node src/scheduler/monthly-ingestion.js",
    "scheduler:samsung": "node src/scheduler/samsung-ingestion.js",
    "ingest": "node src/jobs/ingest-apify-data.js",
    "ingest:brands": "node src/jobs/ingest-brand-stores.js",
    "ingest:samsung": "node src/jobs/ingest-samsung-data.js",
    "ingest:local": "node src/jobs/ingest-local-data.js",
    "sync:stores": "node src/jobs/sync-offline-stores.js",
    "sync:stores:csv": "node src/jobs/sync-offline-stores-csv.js",
    "scheduler:stores": "node src/scheduler/offline-store-sync.js",
    "delete:recent-store": "node delete-recent-store.js",
    "migrate": "node src/database/migrate.js",
    "export": "node src/utils/export-to-excel.js",
    "export:table": "node src/utils/export-table.js",
    "ingest:all": "node src/jobs/ingest-all-stores.js",
    "fetch:stores": "node src/utils/fetch-stores.js"
  },
  "keywords": [
    "product",
    "search",
    "apify",
    "ecommerce"
  ],
  "author": "chethanakash67",
  "license": "MIT",
  "dependencies": {
    "@api/viglink-developer-center": "file:.api/apis/viglink-developer-center",
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "next-auth": "^4.24.14",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2"
  }
}
